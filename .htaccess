<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # v5.8.1 — cabeçalhos de segurança
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
  # CSP ativa (bloqueia o que não está na lista; violações vão para /api/csp.php)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://accounts.google.com https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com https://accounts.google.com; img-src 'self' data: blob: https://*.tile.opentopomap.org https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.googleusercontent.com https://server.arcgisonline.com https://unpkg.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.tile.opentopomap.org https://*.googleapis.com https://accounts.google.com https://server.arcgisonline.com https://api.open-meteo.com https://unpkg.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://fonts.googleapis.com https://fonts.gstatic.com https://maps.gstatic.com https://api.github.com https://overpass-api.de https://overpass.private.coffee https://overpass.kumi.systems; frame-src https://accounts.google.com; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-uri /api/csp.php"
</IfModule>
<IfModule mod_mime.c>
  AddType application/manifest+json .json
  AddType application/javascript .js
</IfModule>
DirectoryIndex index.html
